# =============================================================================
# Docker Ignore File
# =============================================================================
# Exclude these files from Docker build context to speed up builds
# =============================================================================

# Python virtual environment
venv/
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.so

# Node modules (will be rebuilt in container)
node_modules/
.npm/

# IDE and editor files
.idea/
.vscode/
*.swp
*.swo
.DS_Store

# Git
.git/
.gitignore

# Build artifacts
*.jar
*.war
target/
dist/
build/

# Logs
*.log
logs/

# Docker (keep nginx configs)
Dockerfile*
docker-compose*.yml
!docker/nginx*.conf

# Data files (too large for container)
data/*.csv
data/*.db
*.pt
*.pth
*.model

# Documentation
*.md
!README.md

# Tests
tests/
__tests__/
*.test.*
*.spec.*

# Misc
.env*
*.env
.cursor/
terminals/

