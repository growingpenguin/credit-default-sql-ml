# =============================================================================
# CreditWise React Frontend - Dockerfile
# =============================================================================
# Multi-stage build for production-ready frontend
#
# Build:   docker build -f docker/Dockerfile.frontend -t creditwise-frontend:latest .
# Run:     docker run -p 3000:80 creditwise-frontend:latest
# =============================================================================

# -----------------------------------------------------------------------------
# Stage 1: Build Stage
# -----------------------------------------------------------------------------
# Use ARM64 compatible image
FROM node:20 AS builder

# Set working directory
WORKDIR /app

# Copy package files first (for caching)
COPY ["Design CreditWise Platform/package.json", "./package.json"]

# Install dependencies
RUN npm install --legacy-peer-deps

# Copy source code
COPY ["Design CreditWise Platform/", "./"]

# Build for production
# Set API URL to use Nginx proxy (will be /api in production)
ENV VITE_API_URL=/api
RUN npm run build

# -----------------------------------------------------------------------------
# Stage 2: Production Stage with Nginx
# -----------------------------------------------------------------------------
FROM nginx:alpine

# Add labels
LABEL maintainer="CreditWise Team"
LABEL version="1.0.0"
LABEL description="CreditWise React Frontend"

# Remove default nginx config
RUN rm /etc/nginx/conf.d/default.conf

# Copy custom nginx configuration
COPY docker/nginx.frontend.conf /etc/nginx/conf.d/default.conf

# Copy built assets from builder (Vite outputs to 'build' folder)
COPY --from=builder /app/build /usr/share/nginx/html

# Expose port
EXPOSE 80

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost/ || exit 1

# Start Nginx
CMD ["nginx", "-g", "daemon off;"]

